# Baked into the static bundle at build time (adapter-static/SPA — no server to read these at
# runtime). In production, set these as build-time environment variables in Coolify pointing
# at the deployed Colyseus server, instead of localhost.
PUBLIC_COLYSEUS_URL=ws://localhost:2567
PUBLIC_LIVEKIT_TOKEN_ENDPOINT=http://localhost:2567/livekit-token
