# LiveKit connection/signing config (see docker-compose.livekit.yml at the repo root for the
# local dev server these fixed values match — spec 003 "Proximity Voice & Video").
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Signs the proof OfficeRoom.onJoin sends the client, which /livekit-token then verifies to
# confirm a token request's identity really came from a live Colyseus session (session-proof.ts).
# Generate a real random value for production — never reuse this dev placeholder.
SESSION_SIGNING_SECRET=dev-session-signing-secret

# Optional shared-secret room lock (OfficeRoom.onAuth) — when set, only guests who type this
# exact code on the entry form can join at all (movement, presence, and proximity audio/video
# all depend on a successful join). Leave unset for open local dev; set a real value in
# production to restrict access to whoever you share it with.
# ACCESS_CODE=
